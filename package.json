{
  "name": "pleasenobugs-monorepo",
  "private": true,
  "description": "A feedback board for Nimiq mini apps: bugs and ideas, straight from your users.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "site": "node site/serve.mjs",
    "site:board": "node site/board.mjs",
    "site:build": "node site/build.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
