{
  "name": "@pleasenobugs/server",
  "version": "0.2.0",
  "description": "The PleaseNoBugs API: a feedback board for Nimiq mini apps, with pluggable storage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennylenders/PleaseNoBugs.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/lennylenders/PleaseNoBugs#readme",
  "bugs": {
    "url": "https://github.com/lennylenders/PleaseNoBugs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-store.d.ts",
      "import": "./dist/sqlite-store.js"
    }
  },
  "bin": {
    "pleasenobugs-server": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nimiq/core": "^2.7.1",
    "@pleasenobugs/core": "0.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0"
  }
}
