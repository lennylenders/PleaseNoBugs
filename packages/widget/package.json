{
  "name": "pleasenobugs",
  "version": "0.2.0",
  "description": "A feedback board for Nimiq mini apps: bugs and ideas, straight from your users. One tag, or a headless client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennylenders/PleaseNoBugs.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/lennylenders/PleaseNoBugs#readme",
  "bugs": {
    "url": "https://github.com/lennylenders/PleaseNoBugs/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "unpkg": "./dist/pleasenobugs.iife.js",
  "jsdelivr": "./dist/pleasenobugs.iife.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/pleasenobugs.iife.js"
  ],
  "keywords": [
    "nimiq",
    "nimiq-pay",
    "mini-app",
    "feedback",
    "bug-report",
    "feature-request",
    "web-component"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.json",
    "demo": "node demo/serve.mjs",
    "screenshots": "node demo/screenshots.mjs"
  },
  "dependencies": {
    "@pleasenobugs/core": "0.2.0"
  },
  "devDependencies": {
    "@nimiq/core": "^2.7.1",
    "@pleasenobugs/server": "0.2.0",
    "express": "^4.21.2",
    "preact": "^10.24.3",
    "puppeteer-core": "^23.11.1",
    "vite": "^5.4.10"
  }
}
